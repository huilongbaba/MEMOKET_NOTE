/** 闸门的自检：**扫不到东西的闸门会一直是绿的**。
 *
 * 第 704 轮栽过一次：符号按钮那条判据前两版都「跑绿了」，其实一个文件都没匹配上。
 * 扫描型闸门（遍历 `src/` 找违规的那几条）都有同一个失败模式——语料没了、
 * 过滤条件写错了、目录挪了位，它不会报错，它会**通过**。
 *
 * 所以每条扫描型闸门在开扫之前先声明「我至少该看到这么多文件」，看不到就自爆。
 * 数字取当前值的六成左右：留够正常增删的余量，又挡得住「几乎什么都没扫到」。
 */
export function corpus(files: string[], min: number, what: string): string[] {
  if (files.length >= min) return files
  console.error(`闸门失效：只扫到 ${files.length} 个${what}（至少该有 ${min} 个）。`
    + '扫不到东西的闸门会一直是绿的——先确认语料和过滤条件，别把这个数字改小。')
  process.exit(1)
}

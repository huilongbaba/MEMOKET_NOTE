# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.vite/

# 密钥与用户数据
.env
data/
*.sqlite3

# 生成的知识库产物（含用户内容）
artifacts/*
!artifacts/_seed_empty.xml

# 构建产物
frontend/tsconfig.tsbuildinfo

.DS_Store
*.lock

# 本机跑出来的东西，一律进 .local/：bench 产出、prompt 快照、手工备份。
#
# 收进一个目录是为了**根目录一眼能看出哪些是源码**——之前 prompts/ samples/
# data-backup/ 跟 backend/ frontend/ docs/ 平铺在一起，ls 一下八个目录里
# 一半是垃圾。里面全是真实业务内容（定价、众筹计划、团队信息，来自真实
# 会议），而且全部可以重跑生成。
.local/

# bench / soak / 摄入跑出来的运行产物。跟 samples/ 同一个理由：里面是
# **真实业务内容**（会议标题、正文片段、种子名），而且全部可以重跑生成。
backend/scripts/*.jsonl
backend/scripts/*.log
backend/scripts/harness_stress_cycle.txt
backend/scripts/editing_bench_results/
backend/scripts/writing_bench_results/

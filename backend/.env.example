# backend/.env 样板（P19 #1）。**默认值是本机地址**（util/config.py），开发机 / 内网那套写在这里，
# 复制成 backend/.env（gitignored）即可；pydantic-settings 启动时读它，环境变量优先级更高。
# 打包版不读这份（cwd 不在 backend/），用户在设置页填的 provider_config 又优先于这里——这里只是部署覆盖。

# 写作用的 LLM（任何 OpenAI 兼容端点）。内网那台 Muse-Glimmer-30B：
LLM_BASE_URL=http://192.168.77.8:8080/v1
LLM_API_KEY=no-key
LLM_MODEL=muse-glimmer-30b

# 看图（留空 = 跟着写作模型走）。内网那台带视觉：
VISION_BASE_URL=http://192.168.77.8:8080/v1
VISION_API_KEY=no-key
VISION_MODEL=muse-glimmer-30b

# 语音转写（whisper.cpp server）
WHISPER_BASE_URL=http://192.168.77.8:8081

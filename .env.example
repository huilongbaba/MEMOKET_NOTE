# ---- LLM (OpenAI 兼容) ----
# 默认指向内网 DGX Spark 上的 Muse-Glimmer-30B
LLM_BASE_URL=http://192.168.77.8:8080/v1
LLM_API_KEY=no-key
LLM_MODEL=muse-glimmer-30b

# 切商用 API 时改成:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# ---- ASR (Whisper Turbo) ----
WHISPER_BASE_URL=http://192.168.77.8:8081

# ---- KITE 记忆引擎 ----
# 每个用户一个 codebook: {KITE_DATA_DIR}/{user_id}/codebook.xml
KITE_DATA_DIR=./data
# 事实抽取用的模型（入库时异步调用，可以慢）
KITE_EXTRACT_MODEL=muse-glimmer-30b

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
